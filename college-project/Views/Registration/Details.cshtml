@model college_project.Models.StudentRegistration

@{
    ViewData["Title"] = "Application Details";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="~/css/registration-print.css" media="all" />

<div class="container-fluid">

    <!-- Actions Toolbar (Hidden in Print) -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print" style="max-width: 210mm; margin: 0 auto;">
        <h1 class="h3 mb-0 text-gray-800">Student: @Model.FullName</h1>
        <div>
            <button onclick="window.print()" class="btn btn-dark me-2 shadow-sm">
                <i class="bi bi-printer-fill me-2"></i>Print / Save PDF
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Back to List</a>
        </div>
    </div>

    <!-- Printable Area Wrapper -->
    <div class="print-wrapper" id="printableArea">

        <!-- 1. Header Section -->
        <table class="header-table">
            <tr>
                <td style="width: 20%; vertical-align: middle;">
                    <img src="~/images/logo.png" alt="Logo" class="print-logo">
                </td>
                <td style="width: 60%; text-align: center; vertical-align: middle;">
                    <h1 class="college-name">OXFORD COLLEGE</h1>
                    <p class="college-slogan">Excellence in Education & Professional Training</p>
                    <div class="doc-title-box">ENROLLMENT APPLICATION FORM</div>
                </td>
                <td style="width: 20%; text-align: right; vertical-align: middle;">
                    <div class="ref-box">
                        <span class="ref-label">Reference ID</span>
                        <span class="ref-value">#@Model.Id</span>
                    </div>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=80x80&data=@Model.Id-@Model.FullName" class="qr-code" alt="QR Code">
                </td>
            </tr>
        </table>

        <!-- 2. Main Content Table -->
        <table class="content-table">
            <tr>
                <!-- Left Column: Personal Info -->
                <td class="info-col">
                    <div class="section-box h-100">
                        <div class="section-header">APPLICANT PROFILE</div>
                        <div class="section-body text-center">

                            <!-- Personal Photo -->
                            <div class="photo-wrapper">
                                <img src="@Model.PersonalPhotoPath" class="student-photo" alt="Photo" onerror="this.src='https://placehold.co/150x180?text=No+Photo'">
                            </div>

                            <!-- Data List -->
                            <table class="data-table text-start">
                                <tr>
                                    <td class="label">Full Name</td>
                                </tr>
                                <tr>
                                    <td class="value text-uppercase">@Model.FullName</td>
                                </tr>

                                <tr>
                                    <td class="label">Phone Number</td>
                                </tr>
                                <tr>
                                    <td class="value font-monospace">@Model.PhoneNumber</td>
                                </tr>

                                <tr>
                                    <td class="label">Major</td>
                                </tr>
                                <tr>
                                    <td class="value highlight">@Model.Major</td>
                                </tr>

                                <tr>
                                    <td class="label">Registration Date</td>
                                </tr>
                                <tr>
                                    <td class="value">@Model.RegistrationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            </table>

                            <!-- Simple Agreement Status -->
                            <div class="mt-4 pt-3 border-top">
                                <strong class="text-success text-uppercase" style="font-size: 10pt;">
                                    <i class="bi bi-check-all me-1"></i> Charter Agreed
                                </strong>
                            </div>
                        </div>
                    </div>
                </td>

                <!-- Right Column: Terms & Conditions (Replacing Images) -->
                <td class="docs-col">
                    <div class="section-box h-100">
                        <div class="section-header">TERMS & CONDITIONS (CHARTER)</div>
                        <div class="section-body text-justify p-4">

                            <div class="terms-text" style="font-size: 9pt; line-height: 1.5; color: #333; text-align: justify;">
                                <p class="fw-bold mb-2">Transparency Charter & Enrollment Regulations</p>

                                <p class="mb-2"><strong>1. Nature of the Program:</strong> The student acknowledges their complete awareness that the chosen educational program is an "Independent Professional Program" issued by a British entity. These programs are designed according to private vocational training standards and do not fall under the framework of UK Higher Education.</p>

                                <p class="mb-2"><strong>2. Legal Titles:</strong> The titles granted (Professional Master, Doctorate, etc.) are professional training titles describing acquired skills. They do not confer an academic scientific degree recognized by government entities subject to local university regulation laws.</p>

                                <p class="mb-2"><strong>3. Documentation:</strong> The Academy ensures the validity of the certificate from the British source. Notarization proves document legality but does not convert the program into an academic track.</p>

                                <p class="mb-3"><strong>4. Student Declaration:</strong> "I declare that I have read and understood the nature of the Independent Professional Program. I agree to enroll knowing it does not grant a degree affiliated with British Higher Education, nor gives rights to claim academic equivalence or syndicate enrollment."</p>
                            </div>

                            <!-- Final Agreement Signature Block -->
                            <div class="agreement-signature-box mt-4 p-3" style="background-color: #f8f9fa; border: 2px dashed #193750;">
                                <div class="d-flex align-items-center mb-2">
                                    <span class="check-icon me-2" style="font-size: 20pt; color: #193750;">☑</span>
                                    <span class="fw-bold text-uppercase" style="font-size: 11pt; color: #193750;">I HAVE READ AND AGREED</span>
                                </div>
                                <p class="m-0 text-muted fst-italic" style="font-size: 9pt;">
                                    By submitting the electronic form on <strong>@Model.RegistrationDate.ToString("dd MMM yyyy")</strong>, the student <strong>@Model.FullName</strong> has legally agreed to the terms above.
                                </p>
                            </div>

                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <!-- 3. Footer -->
        <div class="print-footer">
            <table class="w-100">
                <tr>
                    <td class="text-start">Oxford College - System Report</td>
                    <td class="text-center">CONFIDENTIAL DOCUMENT</td>
                    <td class="text-end">Printed: @DateTime.Now.ToString("dd MMM yyyy HH:mm")</td>
                </tr>
            </table>
        </div>

    </div>
</div>